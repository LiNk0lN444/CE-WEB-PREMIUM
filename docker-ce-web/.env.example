# Copia este archivo como ".env" (en la misma carpeta que docker-compose.yml) y rellénalo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=ce_web

# URL de la API vista desde el navegador
VITE_API_URL=http://localhost:8000

# Correo (opcional; sin esto la API arranca pero no envía emails)
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_EMAIL=
